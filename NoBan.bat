@echo off
chcp 65001 > nul
setlocal enabledelayedexpansion
title NoBan Launcher v8.1

:: ═════╣ Настройка ANSI цветов ╠═════
for /f %%a in ('echo prompt $E ^| cmd /q /k') do set "ESC=%%a"
set "C_PURP=%ESC%[38;2;217;184;240m"
set "C_BLUE=%ESC%[38;2;184;191;242m"
set "C_GREY=%ESC%[38;2;212;227;234m"
set "C_RED=%ESC%[38;2;255;106;106m"
set "C_GREEN=%ESC%[38;2;168;255;106m"
set "C_YELLOW=%ESC%[38;2;255;233;106m"
set "CL0=%ESC%[0m"

:: ═════╣ Запрос на права администратора ╠═════
if "%1"=="admin" ( goto :menu_start ) else (
    echo Запрос на права администратора...
    powershell -Command "Start-Process 'cmd.exe' -ArgumentList '/c \"\"%~f0\" admin\"' -Verb RunAs"
    exit /b
)

:menu_start
:menu
cls
echo.
echo  %C_BLUE%◄───────────────── %C_PURP%Выберите профиль %C_BLUE%──────────────────►%CL0%
echo.
echo             %C_BLUE%[1] %C_GREY%NoBan (A)      %C_BLUE%[10] %C_GREY%NoBan (J)%CL0%
echo             %C_BLUE%[2] %C_GREY%NoBan (B)      %C_BLUE%[11] %C_GREY%NoBan (K)%CL0%
echo             %C_BLUE%[3] %C_GREY%NoBan (C)      %C_BLUE%[12] %C_GREY%NoBan (L)%CL0%
echo             %C_BLUE%[4] %C_GREY%NoBan (D)      %C_BLUE%[13] %C_GREY%NoBan (M)%CL0%
echo             %C_BLUE%[5] %C_GREY%NoBan (E)      %C_BLUE%[14] %C_GREY%NoBan (N)%CL0%
echo             %C_BLUE%[6] %C_GREY%NoBan (F)      %C_BLUE%[15] %C_GREY%NoBan (O)%CL0%
echo             %C_BLUE%[7] %C_GREY%NoBan (G)      %C_BLUE%[16] %C_GREY%NoBan (P)%CL0%
echo             %C_BLUE%[8] %C_GREY%NoBan (H)      %C_BLUE%[17] %C_GREY%NoBan (Q)%CL0%
echo             %C_BLUE%[9] %C_GREY%NoBan (I)      %C_BLUE%[18] %C_GREY%NoBan (R)%CL0%
echo.
echo  %C_BLUE%◄──────────────────── %C_PURP%NoBan v8.1 %C_BLUE%────────────────────►%CL0%
echo.
set /p menu_choice=Введите выбор [0-18] или [A-R]:

cd /d "%~dp0"

:: Проверяем игровой фильтр напрямую
if exist "%~dp0bin\game_filter.enabled" (
    set "GameFilter=1024-65535"
) else (
    set "GameFilter=12"
)

set "BIN=%~dp0bin\"
set "LISTS=%~dp0lists\"
cd /d "%BIN%"

:: Обработка выбора (цифры и буквы)
if /i "%menu_choice%"=="1" goto noban_a
if /i "%menu_choice%"=="a" goto noban_a
if /i "%menu_choice%"=="2" goto noban_b
if /i "%menu_choice%"=="b" goto noban_b
if /i "%menu_choice%"=="3" goto noban_c
